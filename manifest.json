{
  "manifest_version": 3,
  "name": "Bang Search",
  "version": "0.1.0",
  "description": "DuckDuckGo-style bang (!) shortcuts for Firefox. Select any text, right-click and search it instantly on 13k+ sites (Wikipedia, YouTube, Hepsiburada, Trendyol, GitHub...). Offline fallback included.",
  "author": "Cenk",
  "homepage_url": "https://github.com/cenkt/bang-search-ff",
  "browser_specific_settings": {
    "gecko": {
      "id": "bangs-search@ff-extension.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://duckduckgo.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/picker.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Bang Search",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}