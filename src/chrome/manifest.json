{
  "manifest_version": 3,
  "name": "Bang Search",
  "version": "0.1.1",
  "description": "DuckDuckGo-style bang (!) shortcuts for Chrome. Select any text, right-click and search it instantly on 13k+ sites (Wikipedia, YouTube, GitHub...). Offline fallback included.",
  "author": "Cenk",
  "homepage_url": "https://github.com/cenktekin/bang-search-ff",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://duckduckgo.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "open-bang-picker": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Bang seçiciyi aç"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/bangs.js", "content/content.js"],
      "css": ["content/picker.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Bang Search",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
